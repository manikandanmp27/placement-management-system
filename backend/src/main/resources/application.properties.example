spring.application.name=placement-management-system

server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3306/campus_placement
spring.datasource.username=root
spring.datasource.password=
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false

cors.allowed-origins=http://localhost:5173
 
# JWT Security Configuration
# The JWT secret MUST be supplied via the JWT_SECRET environment variable (minimum 256 bits / 32 bytes).
# Generate a cryptographically secure key:
#   Windows PowerShell:
#     $env:JWT_SECRET = [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
#   Linux / macOS:
#     export JWT_SECRET=$(openssl rand -base64 32)
# Application startup will fail if JWT_SECRET is missing, blank, or shorter than 256 bits.
jwt.secret=${JWT_SECRET:}
jwt.expiration-ms=${JWT_EXPIRATION_MS:86400000}
